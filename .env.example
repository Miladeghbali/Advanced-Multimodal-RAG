# ============================================================
# LLM / OpenRouter (OpenAI-compatible)
# ============================================================
OPENROUTER_API_KEY=your_api_key_here
OPENROUTER_DATA_COLLECTION=deny
LLM_MODEL=openai/gpt-4o-mini
LLM_TIMEOUT_MS=60000
LLM_MAX_RETRIES=2
LLM_MAX_TOKENS=1200

# ============================================================
# Retrieval models
# The default embedding explicitly supports fa/Persian. Benchmark the re-ranker on your own corpus.
# ============================================================
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DEVICE=cpu
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RERANKER_DEVICE=cpu
RERANKER_BATCH_SIZE=8
# For a stronger but much heavier multilingual reranker, benchmark: BAAI/bge-reranker-v2-m3

# ============================================================
# Persistent stores
# ============================================================
CHROMA_PERSIST_DIR=./chroma_db
COLLECTION_NAME=advanced_rag
RAG_STATE_DIR=./rag_state

# ============================================================
# RAG defaults
# ============================================================
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=12
MMR_K=7
MMR_LAMBDA=0.55
RERANK_TOP_K=4
RRF_CONSTANT=60
VECTOR_WEIGHT=1.0
BM25_WEIGHT=1.0
MAX_CONTEXT_CHARS=14000
MAX_HISTORY_MESSAGES=8
ENABLE_QUERY_REWRITE=true

# Operational limits
MAX_UPLOAD_MB=15
MAX_FILES_PER_BATCH=20

# ============================================================
# Optional LangSmith tracing/evaluation
# ============================================================
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=Advanced-Multimodal-RAG
LANGSMITH_LLM_JUDGE=false
